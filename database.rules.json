{
  "rules": {
    "tokyo_trip": {
      "spots": { ".read": "auth != null", ".write": "auth != null" },
      "startDate": { ".read": "auth != null", ".write": "auth != null" },
      "handbookPrompt": { ".read": "auth != null", ".write": "auth != null" },
      "lastUpdate": { ".read": "auth != null", ".write": "auth != null" },
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
